{
  "manifest_version": 3,
  "name": "Sarthi: fill job applications",
  "short_name": "Sarthi",
  "version": "0.1.0",
  "description": "Fills the job application you have open from your own Sarthi, with your tailored resume. You review it and press Submit.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Fill this application with Sarthi",
    "default_popup": "popup.html",
    "default_icon": { "32": "icon-32.png", "128": "icon-128.png" }
  },
  "icons": { "32": "icon-32.png", "128": "icon-128.png" }
}
