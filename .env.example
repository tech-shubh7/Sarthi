# Copy to .env and fill in. Never commit .env.
SARTHI_DATA_DIR=data
SARTHI_LOG_LEVEL=INFO

# Telegram bot token from @BotFather
SARTHI_TELEGRAM_BOT_TOKEN=

# LiteLLM model ids: ollama/llama3.1 (free, local), gemini/gemini-2.0-flash, openai/gpt-4o-mini, ...
SARTHI_LLM_FAST_MODEL=ollama/llama3.1
SARTHI_LLM_QUALITY_MODEL=ollama/llama3.1
SARTHI_LLM_API_KEY=
SARTHI_LLM_DAILY_BUDGET_USD=1.0
