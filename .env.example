# Copy to .env and fill in. Never commit .env.
SARTHI_DATA_DIR=data
SARTHI_LOG_LEVEL=INFO

# Telegram bot token from @BotFather
SARTHI_TELEGRAM_BOT_TOKEN=

# AI models, tried in order until one answers. JSON list of "<provider>/<model>".
# Free and local: ollama/llama3.1 (install Ollama, then `ollama pull llama3.1`).
# Providers: ollama, gemini, openai, anthropic, groq, openrouter, deepseek.
SARTHI_LLM_FAST_MODELS=["ollama/llama3.1"]
SARTHI_LLM_QUALITY_MODELS=["ollama/llama3.1"]
SARTHI_LLM_DAILY_TOKEN_BUDGET=500000
SARTHI_OLLAMA_URL=http://localhost:11434/v1

# Keys only for the providers you list above.
SARTHI_GEMINI_API_KEY=
SARTHI_OPENAI_API_KEY=
SARTHI_ANTHROPIC_API_KEY=
SARTHI_GROQ_API_KEY=
SARTHI_OPENROUTER_API_KEY=
SARTHI_DEEPSEEK_API_KEY=

# Daily digest time (local hour, 0-23)
SARTHI_DIGEST_HOUR=19

# Job sources. Boards are searched with your profile's roles and countries.
SARTHI_JOB_BOARDS=["linkedin","indeed"]
SARTHI_BOARDS_EVERY_MINUTES=60
# Company career boards to watch: "<hiring system>/<company slug>" (see ATS-Scrapers' supported systems)
SARTHI_WATCH_COMPANIES=[]
SARTHI_COMPANIES_EVERY_MINUTES=30
# Free public job feeds (no key): remotive, remoteok, weworkremotely, himalayas, jobicy, arbeitnow,
# workingnomads, hackernews. [] turns them off.
SARTHI_FEEDS=["remotive","remoteok","weworkremotely","himalayas","jobicy","arbeitnow","workingnomads","hackernews"]
SARTHI_FEEDS_EVERY_MINUTES=60
# Freehire: one search over ~90 hiring systems (Workday, Oracle, iCIMS, Taleo...) for your roles
SARTHI_FREEHIRE=true

# Applying (forms are filled in a hidden browser; nothing is sent until you tap Submit in Telegram).
# One-time setup: uv run playwright install chromium
SARTHI_APPLY_HEADLESS=true
SARTHI_APPLY_DAILY_LIMIT=30
