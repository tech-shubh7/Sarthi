# Copy to .env and fill in. Never commit .env.
SARTHI_DATA_DIR=data
SARTHI_LOG_LEVEL=INFO

# Telegram is optional: the dashboard (http://127.0.0.1:8765) does everything. For alerts on your phone,
# tap "Connect Telegram (optional)" on the dashboard: Sarthi's connector gives you a bot of your own in two
# taps, no @BotFather and no token to copy (deploy/telegram-connect). To run another connector, set its
# address below; to turn Telegram off completely, set it empty.
# SARTHI_TELEGRAM_CONNECT_URL=https://sarthi-connect.sarthi.workers.dev
# Or a bot you make yourself: message @BotFather, send /newbot, and paste the token it gives you here.
SARTHI_TELEGRAM_BOT_TOKEN=
# The older shared-bot relay (docs/RELAY.md), for whoever hosts one:
SARTHI_RELAY_URL=

# AI models, tried in order until one answers. JSON list of "<provider>/<model>".
# The lists below cover the free cloud tiers (checked 2026-11-22): add a key for at least one of Gemini,
# Groq or OpenRouter below and leave the lists as they are; models whose key is empty are skipped.
# Providers: ollama, gemini, openai, anthropic, groq, openrouter, deepseek, mistral.
# Free and local (writing documents only; matching never runs on a local model): install Ollama,
# `ollama pull llama3.1`, and add "ollama/llama3.1" to SARTHI_LLM_QUALITY_MODELS.
# Free tiers may keep what you send for training; Sarthi removes your contact details first.
SARTHI_LLM_FAST_MODELS=["gemini/gemini-3.5-flash-lite","groq/openai/gpt-oss-20b","openrouter/nvidia/nemotron-3.5-super-vl:free"]
SARTHI_LLM_QUALITY_MODELS=["gemini/gemini-3.5-flash","gemini/gemini-3.5-flash-lite","groq/openai/gpt-oss-120b","openrouter/nvidia/nemotron-3.5-super-vl:free"]
SARTHI_LLM_DAILY_TOKEN_BUDGET=500000
SARTHI_OLLAMA_URL=http://localhost:11434/v1

# Keys: one is enough. Gemini: https://aistudio.google.com/apikey  Groq: https://console.groq.com/keys
# OpenRouter: https://openrouter.ai/keys  Mistral (free "Experiment" plan): https://console.mistral.ai/api-keys
SARTHI_GEMINI_API_KEY=
SARTHI_OPENAI_API_KEY=
SARTHI_ANTHROPIC_API_KEY=
SARTHI_GROQ_API_KEY=
SARTHI_OPENROUTER_API_KEY=
SARTHI_DEEPSEEK_API_KEY=
SARTHI_MISTRAL_API_KEY=

# Daily digest time (local hour, 0-23)
SARTHI_DIGEST_HOUR=19

# Job sources. Boards are searched with your profile's roles and countries.
SARTHI_JOB_BOARDS=["linkedin","indeed"]
SARTHI_BOARDS_EVERY_MINUTES=60
# Company career boards to watch: "<hiring system>/<company slug>" (see ATS-Scrapers' supported systems)
SARTHI_WATCH_COMPANIES=[]
SARTHI_COMPANIES_EVERY_MINUTES=30
# Free public job feeds (no key): remotive, remoteok, weworkremotely, himalayas, jobicy, arbeitnow,
# workingnomads, hackernews. [] turns them off.
SARTHI_FEEDS=["remotive","remoteok","weworkremotely","himalayas","jobicy","arbeitnow","workingnomads","hackernews"]
SARTHI_FEEDS_EVERY_MINUTES=60
# Freehire: one search over ~90 hiring systems (Workday, Oracle, iCIMS, Taleo...) for your roles
SARTHI_FREEHIRE=true

# Applying (forms are filled in a hidden browser; nothing is sent until you tap Submit in Telegram).
# One-time setup: uv run playwright install chromium
# LinkedIn Easy Apply / Naukri: log in once with your own account (Sarthi never sees the password):
#   uv run sarthi login linkedin     uv run sarthi login naukri
SARTHI_APPLY_HEADLESS=true
SARTHI_APPLY_DAILY_LIMIT=30
# Auto-apply (off by default). A match at or above this % (75-100) is announced in Telegram and applied to
# after the veto window unless you tap Cancel; the form is sent without a tap only when every answer came
# from your profile, and never on LinkedIn, Naukri or other job boards. You can also set it in the chat:
# /autoapply 85   or   /autoapply off
# SARTHI_AUTO_APPLY_MIN_SCORE=85
# Optional cap per day; unset: no cap (each site's own daily limit still applies).
# SARTHI_AUTO_APPLY_DAILY_LIMIT=20
SARTHI_AUTO_APPLY_WAIT_MINUTES=5
# Also send on LinkedIn, Naukri and other job boards with your login (they may restrict accounts that apply
# in bulk). In the chat: /autoapply boards on (or off).
SARTHI_AUTO_APPLY_JOB_BOARDS=false
# Rewrite resume lines per job with the AI (experimental). Off: your own resume is sent exactly as you
# uploaded it (design, links, wording), and only the cover letter is written for each job.
SARTHI_TAILOR_RESUME=false
# Send the jobs you tap Apply on without a Submit tap, when every answer came from your profile.
# In the chat: /autoapply taps on (or off).
SARTHI_AUTO_APPLY_TAPS_SEND=false

# Reply tracking (optional): Sarthi only reads your mailbox, never sends, moves or deletes anything.
# Gmail: SARTHI_MAIL_IMAP_HOST=imap.gmail.com and an app password (myaccount.google.com/apppasswords).
# Or set it on the dashboard (Settings > Mail): saved in data/mail.json, it wins over these, no restart needed.
SARTHI_MAIL_IMAP_HOST=
SARTHI_MAIL_IMAP_PORT=993
SARTHI_MAIL_USER=
SARTHI_MAIL_PASSWORD=
SARTHI_MAIL_EVERY_MINUTES=10
SARTHI_FOLLOWUP_AFTER_DAYS=10

# Adzuna and Jooble: big free job aggregators, searched for your roles when a key is set.
# Adzuna: free app id + key at https://developer.adzuna.com  Jooble: free key at https://jooble.org/api/about
SARTHI_ADZUNA_APP_ID=
SARTHI_ADZUNA_APP_KEY=
SARTHI_JOOBLE_API_KEY=
